# Copia este archivo a .env (NO lo subas a GitHub) y rellena los valores.
# Clave que protege la API del backend y el proxy del LLM (mínimo 16 caracteres). Genera una así:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Ollama local (por defecto escucha solo en localhost)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Datos públicos de MEXC (no requieren clave). NO pongas claves de trading aquí.
MEXC_BASE_URL=https://api.mexc.com

# Base de datos y ritmo de consulta (segundos entre revisiones de vela nueva)
DB_PATH=data/bot.db
POLL_SECONDS=300
